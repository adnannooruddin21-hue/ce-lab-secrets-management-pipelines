#!/usr/bin/env bash
set -euo pipefail
 
echo "Scanning staged files for secrets..."
 
# POSIX extended regular expressions, so this works with GNU grep and with the
# BSD grep shipped on macOS. Avoid grep -P: it is a GNU-only extension.
PATTERNS=(
  'AKIA[0-9A-Z]{16}'                                     # AWS Access Key ID
  'sk_live_[a-zA-Z0-9]{24,}'                             # Stripe live key
  'ghp_[a-zA-Z0-9]{36}'                                  # GitHub personal access token
  'xox[bpas]-[a-zA-Z0-9-]{10,}'                          # Slack token
  '-----BEGIN (RSA |EC )?PRIVATE KEY-----'               # Private keys
  "password[[:space:]]*=[[:space:]]*[\"'][^\"']{8,}[\"']" # Hardcoded passwords
)
 
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
 
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to scan."
  exit 0
fi
 
FOUND=0
while IFS= read -r file; do
  [ -n "$file" ] || continue
  [ -f "$file" ] || continue
 
  for pattern in "${PATTERNS[@]}"; do
    # Capture line numbers only. Never print the matching line: a scanner that
    # echoes what it found would leak the secret into your terminal and your CI log.
    if MATCHES=$(grep -En "$pattern" "$file" 2>/dev/null); then
      LINES=$(printf '%s\n' "$MATCHES" | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')
      echo "ALERT: potential secret in $file (line(s): $LINES)"
      echo "       matched pattern: $pattern"
      FOUND=1
    fi
  done
done <<< "$STAGED_FILES"
 
if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo "COMMIT BLOCKED: Potential secrets detected."
  echo "Remove the secrets or add the files to .gitignore."
  exit 1
fi
 
echo "Scan complete: no secrets found."
exit 0